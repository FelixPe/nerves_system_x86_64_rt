#!/bin/sh

set -eu

pidfile=/run/dockerd.pid

log_error() {
    printf '<3>nerves-dockerd: %s\n' "$1" > /dev/kmsg 2>/dev/null || true
}

if ! awk '$2 == "/root" && $3 == "ext4" { mounted = 1 } END { exit !mounted }' /proc/mounts; then
    log_error "persistent /root ext4 partition is not mounted; dockerd was not started"
    exit 0
fi

mkdir -p /root/docker /run /sys/fs/cgroup

if ! awk '$2 == "/sys/fs/cgroup" && $3 == "cgroup2" { mounted = 1 } END { exit !mounted }' /proc/mounts; then
    if ! mount -t cgroup2 none /sys/fs/cgroup; then
        log_error "unable to mount cgroup v2; dockerd was not started"
        exit 0
    fi
fi

if [ -r "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
    exit 0
fi

rm -f "$pidfile"
if ! start-stop-daemon --start --background --make-pidfile \
    --pidfile "$pidfile" --exec /usr/libexec/nerves-dockerd -- \
    --config-file=/etc/docker/daemon.json --pidfile="$pidfile"; then
    log_error "failed to start dockerd"
fi