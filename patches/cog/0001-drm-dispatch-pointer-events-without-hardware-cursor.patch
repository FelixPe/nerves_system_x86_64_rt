From: Nerves x86_64 RT maintainers
Subject: [PATCH] drm: dispatch pointer events without a hardware cursor

Allow COG_PLATFORM_DRM_POINTER=1 to enable pointer input independently of
hardware cursor support. Use the selected DRM mode for pointer bounds and
initial coordinates, even when cursor initialization fails. Keep existing
pointer input behavior when a hardware cursor is successfully initialized.

Upstream: Not submitted (local backport for Cog 0.18.5)

--- a/platform/drm/cog-platform-drm.c
+++ b/platform/drm/cog-platform-drm.c
@@ -164,6 +164,8 @@
+static gboolean pointer_enabled = FALSE;
+
 static struct {
     gboolean enabled;
     struct kms_device *device;
     struct kms_plane *plane;
     struct kms_framebuffer *cursor;
     unsigned int x;
@@ -644,11 +646,6 @@
         return FALSE;
     }
 
-    cursor.x = (cursor.device->screens[0]->width - cursor.cursor->width) / 2;
-    cursor.y = (cursor.device->screens[0]->height - cursor.cursor->height) / 2;
-    cursor.screen_width = cursor.device->screens[0]->width;
-    cursor.screen_height = cursor.device->screens[0]->height;
-
     if (kms_plane_set(cursor.plane, cursor.cursor, cursor.x, cursor.y)) {
         g_clear_pointer(&cursor.device, kms_device_free);
         g_clear_pointer(&cursor.cursor, kms_framebuffer_free);
@@ -861,7 +858,7 @@
 static void
 input_handle_pointer_motion_event(struct libinput_event_pointer *pointer_event, bool absolute)
 {
-    if (!cursor.enabled)
+    if (!pointer_enabled)
         return;
 
     if (absolute) {
@@ -895,13 +892,14 @@
     };
 
     wpe_view_backend_dispatch_pointer_event(wpe_view_data.backend, &event);
-    kms_plane_set(cursor.plane, cursor.cursor, cursor.x, cursor.y);
+    if (cursor.enabled)
+        kms_plane_set(cursor.plane, cursor.cursor, cursor.x, cursor.y);
 }
 
 static void
 input_handle_pointer_button_event (struct libinput_event_pointer *pointer_event)
 {
-    if (!cursor.enabled)
+    if (!pointer_enabled)
         return;
 
     struct wpe_input_pointer_event event = {
@@ -1425,13 +1423,20 @@
         return FALSE;
     }
 
+    cursor.screen_width = drm_data.width;
+    cursor.screen_height = drm_data.height;
+    cursor.x = cursor.screen_width / 2;
+    cursor.y = cursor.screen_height / 2;
+
     if (g_getenv ("COG_PLATFORM_DRM_CURSOR")) {
         if (!init_cursor ()) {
             g_warning ("Failed to initialize cursor");
         }
     }
 
+    pointer_enabled = cursor.enabled || g_strcmp0(g_getenv("COG_PLATFORM_DRM_POINTER"), "1") == 0;
+
     if (!init_gbm ()) {
         g_set_error_literal (error,
                              COG_PLATFORM_WPE_ERROR,
                              COG_PLATFORM_WPE_ERROR_INIT,
